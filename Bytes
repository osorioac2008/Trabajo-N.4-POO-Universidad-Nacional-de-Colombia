Ing_archivo = tk.Entry(Interfaz, width = 20)
Ing_archivo.grid(row = 3, column = 0, pady = 10, padx = 15)

def calculo_normal():
    try:
        archivo = Ing_archivo.get()
        desencriptar = normal(archivo)
        desencriptado.set(f"{desencriptar}")
             
    except ValueError as x:
        messagebox.showwarning("Fallo de desencriptacion", x) 
        
def calculo_mayusculas():
    try:
        archivo = Ing_archivo.get()
        desencriptar = Mayusculas(archivo)
        desencriptado.set(f"{desencriptar}") 
        
    except ValueError as x:
        messagebox.showwarning  

Bot_archivo_1 = tk.Button(Interfaz, text = "Busqueda y rescate basico", width = 40, command = calculo_normal)
Bot_archivo_1.grid(row = 4, column = 0, pady = 10)

Bot_archivo_2 = tk.Button(Interfaz, text = "Busqueda y rescate mayusculo", width = 40, command = calculo_mayusculas)
