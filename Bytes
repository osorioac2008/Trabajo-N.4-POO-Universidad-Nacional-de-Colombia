import tkinter as tk
from tkinter import messagebox



def extractor(archivo):
    
    if archivo == "":
        raise ValueError("Campo Vacio")
    
    pruebas = open(f"{archivo}.txt", "rb")

    bytes = []

    while True:
        byte = pruebas.read(1)
        if byte == b"":
            break
        bytes.append(byte)

    unidos = b"".join(bytes)
    pruebas.close()
    return unidos.decode("utf-8")

def Mayusculas(archivo):
    texto = extractor(archivo)
    return texto.upper()
def normal(archivo):
    texto = extractor(archivo)
    return texto


Interfaz = tk.Tk()
Interfaz.option_add("*background", "dark slate gray")
Interfaz.option_add("*foreground", "snow")

Interfaz.title("EXTRACTOR DE BYTES")
Interfaz.geometry("400x450")
Interfaz.resizable(False, False)
Interfaz.configure(bg = "dark slate gray")

Titulo = tk.Label(Interfaz, text = "Extraccion de bytes de archivos", font = ("Times New roman", 20, "bold"))
Titulo.grid(row = 0, column = 0, pady = 20, padx = 15)


Subtitulo = tk.Label(Interfaz, text = "Ingrese el nombre del archivo:", font = ("Times New roman", 14))
