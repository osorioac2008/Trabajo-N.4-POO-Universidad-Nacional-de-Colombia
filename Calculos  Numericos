        lbl_raiz = tk.Label(
            self.tab_basicos,
            text="Calculo de raiz\nIngrese numero",
            font=("Times New Roman", 12),
            bg="dark slate gray",
            fg="thistle2",
        )
        lbl_raiz.grid(row=0, column=1, pady=10, padx=20)

        self.ent_valor = tk.Entry(self.tab_basicos, width=15, justify="center")
