        self.ent_y1 = tk.Entry(frame_pendiente, width=3, justify="center")
        self.ent_y1.grid(row=0, column=1, pady=10, padx=5)
        self.ent_x2 = tk.Entry(frame_pendiente, width=3, justify="center")
