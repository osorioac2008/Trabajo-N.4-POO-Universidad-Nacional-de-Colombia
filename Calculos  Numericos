import math
import tkinter as tk
from tkinter import messagebox, ttk


# --- BACKEND (Según diagrama de clases StarUML) ---
class CalculosNumericos:
    @staticmethod
    def neperiano(valor: float) -> float:
        if valor <= 0:
            raise ValueError("Valor negativo o nulo para logaritmo natural.")
        return math.log(valor)

    @staticmethod
    def raiz_cuadrada(valor: float) -> float:
        if valor < 0:
            raise ValueError("Valor negativo para raíz cuadrada real.")
        return math.sqrt(valor)

    @staticmethod
    def pendiente_recta(x1: float, y1: float, x2: float, y2: float) -> float:
        if x2 == x1:
            raise ValueError("Recta vertical: x1 y x2 no pueden ser iguales.")
        return (y2 - y1) / (x2 - x1)

    @staticmethod
    def punto_medio(x1: float, y1: float, x2: float, y2: float) -> tuple[float, float]:
        if x1 == x2 and y1 == y2:
            raise ValueError("Mismo punto en ambos extremos.")
        xm = round((x1 + x2) / 2, 1)
        ym = round((y1 + y2) / 2, 1)
        return xm, ym

    @staticmethod
    def raices_cuadratica(a: float, b: float, c: float) -> tuple[float, float]:
        if a == 0:
            raise ValueError("Falla la lógica matemática: 'a' no puede ser cero.")
        discriminante = (b**2) - (4 * a * c)
        if discriminante < 0:
            raise ValueError("Discriminante negativo: sin soluciones reales.")
        raiz_disc = math.sqrt(discriminante)
        x1 = (-b - raiz_disc) / (2 * a)
        x2 = (-b + raiz_disc) / (2 * a)
        return x1, x2

    @staticmethod
    def convertir_base(numero: int, base: int) -> str:
        if not (2 <= base <= 36):
            raise ValueError("Base indefinida: debe estar entre 2 y 36.")
        if numero < 0:
            raise ValueError("El número debe ser un entero positivo o cero.")
        if numero == 0:
            return "0"

        digitos = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        resultado: list[str] = []
        actual = numero
        while actual > 0:
            actual, residuo = divmod(actual, base)
            resultado.append(digitos[residuo])
        return "".join(reversed(resultado))


