    def _construir_panel_salida(self) -> None:
        titulo_2 = tk.Label(
            self.raiz,
            text="<<<<< RESPUESTAS >>>>>",
            font=("Times New Roman", 16, "bold"),
            bg="dark slate gray",
            fg="thistle2",
        )
        titulo_2.pack(pady=20)

        frame_respuesta = tk.Frame(self.raiz, width=1, bg="dark slate gray")
        frame_respuesta.pack(fill="x", expand=True)
        frame_respuesta.columnconfigure((0, 1, 2, 3, 4, 5), weight=1)

        respuestas = [
            self.resp_log,
            self.resp_raiz,
            self.resp_pend,
            self.resp_pm,
            self.resp_raices,
            self.resp_bb,
        ]

        for col, var_resp in enumerate(respuestas):
            lbl = tk.Label(
                frame_respuesta,
                textvariable=var_resp,
                font=("Times New Roman", 12),
                bg="dark slate gray",
                fg="thistle2",
            )
            lbl.grid(row=0, column=col, pady=10, padx=20)

    def _leer_floats(self, *entries: tk.Entry) -> list[float]:
        valores: list[float] = []
        for ent in entries:
            texto = ent.get().strip().replace(",", ".")
            if not texto:
                raise ValueError("Campo vacío")
            try:
                valores.append(float(texto))
            except ValueError as exc:
                raise ValueError(f"'{texto}' no es un número válido.") from exc
        return valores

    def _limpiar_entries(self, *entries: tk.Entry) -> None:
        for ent in entries:
            ent.delete(0, tk.END)

    def _mostrar_exito(self, titulo: str, mensaje: str, valor_copiable: str) -> None:
        self.var_resultado.set(f"{titulo}: {mensaje}")
        self._ultimo_valor = valor_copiable

    def _mostrar_error(self, titulo: str, mensaje: str) -> None:
        self.var_resultado.set(f"{titulo}: {mensaje}")
        messagebox.showerror("Fallo de cálculo", mensaje)

    def _copiar_resultado(self) -> None:
        self.raiz.clipboard_clear()
        self.raiz.clipboard_append(self._ultimo_valor)

    def ejecutar_unario(self, operacion: str) -> None:
        try:
            if operacion == "log":
                (valor,) = self._leer_floats(self.ent_valor)
                calculo = CalculosNumericos.neperiano(valor)
                texto = f"~ Ln({valor})\n---> {round(calculo, 2)}"
                self.resp_log.set(texto)
                self._mostrar_exito("Logaritmo", texto, str(round(calculo, 2)))
            elif operacion == "raiz":
                (valor,) = self._leer_floats(self.ent_raiz)
                calculo = CalculosNumericos.raiz_cuadrada(valor)
                texto = f" ~ √({valor})\n---> {round(calculo, 2)}"
                self.resp_raiz.set(texto)
                self._mostrar_exito("Raíz cuadrada", texto, str(round(calculo, 2)))
        except ValueError as err:
            self._mostrar_error("Error unario", str(err))

    def ejecutar_geometria(self, modo: str) -> None:
        try:
            if modo == "pendiente":
                x1, y1, x2, y2 = self._leer_floats(
                    self.ent_x1, self.ent_y1, self.ent_x2, self.ent_y2
                )
                calculo = CalculosNumericos.pendiente_recta(x1, y1, x2, y2)
                texto = f"~ Pend(({x1},{y1}), ({x2},{y2}))\n---> {round(calculo, 4)}"
                self.resp_pend.set(texto)
                self._mostrar_exito("Pendiente", texto, str(round(calculo, 4)))
            elif modo == "medio":
                x1, y1, x2, y2 = self._leer_floats(
                    self.ent_pm_x1, self.ent_pm_y1, self.ent_pm_x2, self.ent_pm_y2
                )
                xm, ym = CalculosNumericos.punto_medio(x1, y1, x2, y2)
                texto = f"~ Pm(({x1},{y1}), ({x2},{y2}))\n---> ({xm}, {ym})"
                self.resp_pm.set(texto)
                self._mostrar_exito("Punto medio", texto, f"({xm}, {ym})")
        except ValueError as err:
            self._mostrar_error("Error en geometría", str(err))

    def ejecutar_cuadratica(self) -> None:
        try:
            a, b, c = self._leer_floats(self.ent_a, self.ent_b, self.ent_c)
            x1, x2 = CalculosNumericos.raices_cuadratica(a, b, c)
            texto = f"~ {a}x^2 + {b}x + {c}\n---> X1 ={round(x1, 4)}, X2 = {round(x2, 4)}"
            self.resp_raices.set(texto)
            self._mostrar_exito(
                "Ecuación cuadrática", texto, f"{round(x1, 4)}, {round(x2, 4)}"
            )
        except ValueError as err:
            self._mostrar_error("Error en cuadrática", str(err))

    def ejecutar_conversion(self) -> None:
        try:
            num_txt = self.ent_numero.get().strip()
            base_txt = self.spin_base.get().strip()
            if not num_txt or not base_txt:
                raise ValueError("Campo vacío")
            try:
                numero = int(num_txt)
                base = int(base_txt)
            except ValueError as exc:
                raise ValueError(
                    "Tanto el número como la base deben ser enteros."
                ) from exc

            calculo = CalculosNumericos.convertir_base(numero, base)
            texto = f"~ {numero} en base 10\n---> {calculo} en base {base}"
            self.resp_bb.set(texto)
            self._mostrar_exito("Conversión de base", texto, calculo)
        except ValueError as err:
            self._mostrar_error("Error de conversión", str(err))

    def _calcular_todo(self) -> None:
        if self.ent_valor.get().strip():
            self.ejecutar_unario("log")
        if self.ent_raiz.get().strip():
            self.ejecutar_unario("raiz")
        if any(
            e.get().strip()
            for e in (self.ent_x1, self.ent_y1, self.ent_x2, self.ent_y2)
        ):
            self.ejecutar_geometria("pendiente")
        if any(
            e.get().strip()
            for e in (self.ent_pm_x1, self.ent_pm_y1, self.ent_pm_x2, self.ent_pm_y2)
        ):
            self.ejecutar_geometria("medio")
        if any(e.get().strip() for e in (self.ent_a, self.ent_b, self.ent_c)):
            self.ejecutar_cuadratica()
        if self.ent_numero.get().strip():
            self.ejecutar_conversion()


if __name__ == "__main__":
    raiz = tk.Tk()
    app = AppGUI(raiz)
    raiz.mainloop()
