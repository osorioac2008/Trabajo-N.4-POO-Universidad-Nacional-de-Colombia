        self.resp_pm = tk.StringVar(value=" ~ Pm(x)\n---> (???, ???)")
        self.resp_raices = tk.StringVar(value=" ~ ax^2 + bx + c\n---> X1 = ?, X2 = ? ")
        self.resp_bb = tk.StringVar(value=" ~ x en base 10\n---> ??? en base y")

        titulo = tk.Label(
            self.raiz,
            text="CALCULOS NUMERICOS",
            font=("Times New Roman", 18, "bold"),
            bg="dark slate gray",
            fg="thistle2",
        )
        titulo.pack(pady=20)

        tk.Frame(self.raiz, height=2, bg="snow").pack(fill="x", padx=20, pady=20)

        self.tab_basicos = tk.Frame(self.raiz, width=1, bg="dark slate gray")
        self.tab_basicos.pack(fill="x", expand=True)
        self.tab_basicos.columnconfigure((0, 1, 2, 3, 4, 5), weight=1)

        self._construir_tab_basicos()
        self._construir_tab_avanzados()

        boton = tk.Button(
            self.raiz,
            width=20,
            command=self._calcular_todo,
            bg="gray36",
            fg="azure",
            text="---> Calcular <---",
        )
        boton.pack(pady=20)

        tk.Frame(self.raiz, height=2, bg="snow").pack(fill="x", padx=20, pady=20)

        self._construir_panel_salida()

