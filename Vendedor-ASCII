import tkinter as tk
from tkinter import messagebox, ttk


class SimboloNuloError(Exception):
    pass


class SimboloInexistenteError(Exception):
    pass


class Vendedor:
    def __init__(self, nombres: str, apellidos: str, edad: int):
        if not isinstance(edad, int) or isinstance(edad, bool):
            raise TypeError("El parámetro de edad debe ser numérico.")

        self.verificar_edad(edad)
        self.nombres: str = nombres
        self.apellidos: str = apellidos
        self.edad: int = edad

    def verificar_edad(self, edad: int) -> None:
        if edad < 0 or edad > 120:
            raise ValueError("La edad no puede ser negativa ni mayor a 120.")
        if edad < 18:
            raise ValueError("El vendedor debe ser mayor de 18 años.")

    def imprimir(self) -> str:
        mensaje = (
            f"Bienvenido, sus datos:\n"
            f"Nombre: {self.nombres}\n"
            f"Apellido: {self.apellidos}\n"
            f"Edad: {self.edad}"
        )
        print(f"{self.nombres} {self.apellidos} - Edad: {self.edad}")
        return mensaje


class TablaASCII:
    def __init__(self):
        self.tabla: dict[str, int] = {}

    def setter(self, simbolo: str, numero: int) -> None:
        if not simbolo:
            raise SimboloNuloError("El símbolo no puede ser nulo o vacío.")
        if not isinstance(numero, int) or isinstance(numero, bool):
            raise TypeError("El valor debe ser un número entero.")
        self.tabla[simbolo] = numero

    def getter(self, simbolo: str) -> int:
        if not simbolo:
            raise SimboloNuloError("El símbolo no puede ser nulo o vacío.")
        if simbolo not in self.tabla:
            raise SimboloInexistenteError(
                f"El símbolo '{simbolo}' no tiene un valor asociado."
            )
        return self.tabla[simbolo]


class AppGUI:
    def __init__(self, raiz: tk.Tk):
        self.raiz: tk.Tk = raiz
        self.raiz.title("Tienda de Don Pancho - Gestor de Excepciones")
        self.raiz.resizable(False, False)
        self.raiz.option_add("*background", "dark slate gray")
        self.raiz.option_add("*foreground", "snow")
        self.raiz.configure(bg="dark slate gray")

        self.backend_ascii: TablaASCII = TablaASCII()
        self.notebook: ttk.Notebook | None = None
        self.tab_vendedor: ttk.Frame | None = None
        self.tab_ascii: ttk.Frame | None = None

        self.verificado: tk.StringVar = tk.StringVar(
            value="¿Cumple con las especificaciones?\n--->  <---"
        )

        tk.Label(self.raiz, text="INGRESO DE USUARIO", font=30).pack(pady=(20, 8))
        tk.Label(
            self.raiz,
            text="Bienvenido, ingrese su nombre, apellido y edad",
            font=16,
        ).pack(pady=(0, 10))

        self._construir_tab_vendedor()

        espacio_verificacion = tk.Frame(self.raiz, height=2, bg="snow")
        espacio_verificacion.pack(fill="x", pady=5)

        tk.Label(self.raiz, text="VERIFICACION EN PROCESO...", font=15).pack(
            pady=(15, 5)
        )
        tk.Label(self.raiz, textvariable=self.verificado, pady=10).pack()

        espacio_menu = tk.Frame(self.raiz, height=2, bg="snow")
        espacio_menu.pack(fill="x", pady=5)

        tk.Label(self.raiz, text="MENU DEL DIA", font=15).pack(pady=(15, 5))

        self._construir_tab_ascii()

        self.controles_menu = [
            self.ent_simbolo_get,
            self.btn_buscar_ascii,
            self.ent_numero_set,
            self.ent_simbolo_set,
            self.btn_guardar_ascii,
        ]
        self._set_menu_habilitado(False)

    def _construir_tab_vendedor(self) -> None:
        frame_registro = tk.Frame(self.raiz)
        frame_registro.pack(fill="x", pady=10, expand=True)

        tk.Label(frame_registro, text="Nombre del usuario").grid(row=0, column=0)
        tk.Label(frame_registro, text="Apellido del usuario").grid(row=0, column=1)
        tk.Label(frame_registro, text="Edad del usuario").grid(row=0, column=2)

        self.ent_nombres: tk.Entry = tk.Entry(
            frame_registro, width=12, bg="snow", fg="dark slate gray"
        )
        self.ent_nombres.grid(row=1, column=0)

        self.ent_apellidos: tk.Entry = tk.Entry(
            frame_registro, width=12, bg="snow", fg="dark slate gray"
        )
        self.ent_apellidos.grid(row=1, column=1)

        self.ent_edad: tk.Entry = tk.Entry(
            frame_registro, width=12, bg="snow", fg="gray1"
        )
        self.ent_edad.grid(row=1, column=2)

        self.btn_registro: tk.Button = tk.Button(
            frame_registro,
            width=20,
            command=self.ejecutar_vendedor,
            text=">>> Registro <<<",
            bg="snow",
            fg="gray1",
        )
        self.btn_registro.grid(row=2, column=1, pady=15)

        for widget in frame_registro.winfo_children():
            widget.grid_configure(pady=8, padx=18)

    def _construir_tab_ascii(self) -> None:
        frame_listado = tk.Frame(self.raiz)
        frame_listado.pack(fill="x", pady=10, padx=15)
        frame_listado.columnconfigure((0, 1), weight=1)

        frame_busqueda = tk.Frame(frame_listado)
        frame_busqueda.grid(row=0, column=0, padx=10, pady=5)

        tk.Label(frame_busqueda, text="...Busqueda...\nSimbolo", font=10).grid(
            row=0, column=0, pady=8, padx=15
        )
        self.ent_simbolo_get: tk.Entry = tk.Entry(
            frame_busqueda, width=12, bg="snow", fg="gray1"
        )
        self.ent_simbolo_get.grid(row=1, column=0, pady=8, padx=15)

        self.btn_buscar_ascii: tk.Button = tk.Button(
            frame_busqueda,
            width=12,
            command=self.ejecutar_get_ascii,
            text="Envio",
            bg="snow",
            fg="gray1",
        )
        self.btn_buscar_ascii.grid(row=2, column=0, pady=8, padx=15)

        frame_creacion = tk.Frame(frame_listado)
        frame_creacion.grid(row=0, column=1, padx=10, pady=5)

        tk.Label(
            frame_creacion, text="...ingreso...\nNumero ---- Simbolo", font=10
        ).grid(row=0, column=0, columnspan=2, pady=8, padx=15)

        self.ent_numero_set: tk.Entry = tk.Entry(
            frame_creacion, width=10, bg="snow", fg="gray1"
        )
        self.ent_numero_set.grid(row=1, column=0, pady=8, padx=8)

        self.ent_simbolo_set: tk.Entry = tk.Entry(
            frame_creacion, width=10, bg="snow", fg="gray1"
        )
        self.ent_simbolo_set.grid(row=1, column=1, pady=8, padx=8)

        self.btn_guardar_ascii: tk.Button = tk.Button(
            frame_creacion,
            width=12,
            command=self.ejecutar_set_ascii,
            text="Envio",
            bg="snow",
            fg="gray1",
        )
        self.btn_guardar_ascii.grid(row=2, column=0, columnspan=2, pady=8, padx=15)

    def _set_menu_habilitado(self, habilitado: bool) -> None:
        estado = "normal" if habilitado else "disabled"
        for widget in self.controles_menu:
            widget.configure(state=estado)

    def ejecutar_vendedor(self) -> None:
        try:
            nom = self.ent_nombres.get().strip()
            ape = self.ent_apellidos.get().strip()
            edad_texto = self.ent_edad.get().strip()

            if not nom or not ape or not edad_texto:
                raise ValueError("Faltan campos vacios")

            try:
                edad_int = int(edad_texto)
            except ValueError:
                raise TypeError("La edad debe ser un número entero válido.")

            vendedor = Vendedor(nom, ape, edad_int)
            self.verificado.set("¿Cumple con las especificaciones?\n---> Cumple <---")
            saludo = vendedor.imprimir()
            self._set_menu_habilitado(True)
            messagebox.showinfo("REGISTRO EXITOSO", saludo)

            self.ent_nombres.delete(0, tk.END)
            self.ent_apellidos.delete(0, tk.END)
            self.ent_edad.delete(0, tk.END)

        except (ValueError, TypeError) as error:
            self.verificado.set(
                f"¿Cumple con las especificaciones?\n---> No cumple: {error} <---"
            )
            self._set_menu_habilitado(False)
            messagebox.showwarning("Advertencia", str(error))

    def ejecutar_set_ascii(self) -> None:
        try:
            simbolo = self.ent_simbolo_set.get().strip()
            num_texto = self.ent_numero_set.get().strip()

            if not simbolo or not num_texto:
                raise SimboloNuloError("Faltan campos vacios")

            try:
                num_int = int(num_texto)
            except ValueError:
                raise TypeError("El valor a guardar debe ser un número entero.")

            self.backend_ascii.setter(simbolo, num_int)
            messagebox.showinfo(
                "CREACION EXITOSA",
                f"Se a creado el elemento {simbolo} con numero {num_int}",
            )

            self.ent_simbolo_set.delete(0, tk.END)
            self.ent_numero_set.delete(0, tk.END)

        except (SimboloNuloError, TypeError) as error:
            messagebox.showwarning("Advertencia", str(error))

    def ejecutar_get_ascii(self) -> None:
        try:
            simbolo = self.ent_simbolo_get.get().strip()

            if not simbolo:
                raise SimboloNuloError("Faltan campos vacios")

            resultado = self.backend_ascii.getter(simbolo)
            messagebox.showinfo(
                "ENCONTRADO",
                f"Se encontro su numero ascociado: {resultado}",
            )

            self.ent_simbolo_get.delete(0, tk.END)

        except (SimboloNuloError, SimboloInexistenteError) as error:
            messagebox.showwarning("Advertencia", str(error))


if __name__ == "__main__":
    raiz = tk.Tk()
    app = AppGUI(raiz)
    raiz.mainloop()
